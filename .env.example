# ========== npm registry mirror ==========
# Leave empty to use default https://registry.npmjs.org
NPM_REGISTRY=https://registry.npmmirror.com/

# ========== Time Zone ==========
TIMEZONE=Asia/Shanghai

# ========== Database (single source of truth) ==========
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=zenportal
DB_PORT=5432

# backend/.env DATABASE_URL is generated by scripts/setup.js from DB_* vars
# (inside containers docker-compose assembles it), no hardcoded port here

# ========== Backend ==========
BACKEND_PORT=3000

# ========== Media Upload Size Limits (MB) ==========
MEDIA_MAX_IMAGE_SIZE_MB=10
MEDIA_MAX_VIDEO_SIZE_MB=50
MEDIA_MAX_AUDIO_SIZE_MB=10

# ========== Admin Auth ==========
# Generate with: openssl rand -hex 32
ADMIN_TOKEN=change-me-to-a-random-64-char-hex-string
VISITOR_SALT=change-me-to-a-random-32-char-hex-string

# ========== Frontend ==========
# override in .env only if needed — dev default /api (vite proxy), prod /api
# VITE_API_BASE_URL=/api
FRONTEND_PORT=5173
# Vite dev server allowed Host headers (comma-separated); unset = localhost only
# ALLOWED_HOSTS=my-domain.example.com
VITE_ADMIN_SECRET_PATH=my-admin-path
