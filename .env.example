# ========== npm registry mirror ==========
# Leave empty to use default https://registry.npmjs.org
NPM_REGISTRY=https://registry.npmmirror.com/

# ========== Time Zone ==========
TIMEZONE=Asia/Shanghai

# ========== Database (single source of truth) ==========
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=zenportal

# Local Prisma connection (used by npx prisma commands)
# Inside containers, docker-compose constructs DATABASE_URL from DB_* vars above.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/zenportal"

# ========== Backend ==========
PORT=3000

# ========== Admin Auth ==========
# Generate with: openssl rand -hex 32
ADMIN_TOKEN=change-me-to-a-random-64-char-hex-string
VISITOR_SALT=change-me-to-a-random-32-char-hex-string

# ========== Frontend ==========
VITE_API_BASE_URL=http://localhost:3000/api
VITE_ADMIN_SECRET_PATH=my-admin-path
